{
  "info": {
    "name": "LORDMINDS ACADEMY - Admin",
    "description": "Complete API testing collection for Admin functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
